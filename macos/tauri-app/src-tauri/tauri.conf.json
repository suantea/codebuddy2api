{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy2API",
  "version": "1.0.0",
  "identifier": "com.suantea.workbuddy2api",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "WorkBuddy2API",
        "width": 1100,
              "height": 760,
              "minWidth": 900,
              "minHeight": 600,
              "resizable": true,
              "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}